# Copy to .env and restart `npx expo start`.
# Leave EXPO_PUBLIC_API_URL empty to run the app on built-in demo data.
#
# Use your computer's LAN IP (not localhost) when testing on a physical phone,
# or http://10.0.2.2:8000 from the Android emulator.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Force demo data even when an API URL is set.
EXPO_PUBLIC_USE_MOCKS=false

# Use React Native's fetch instead of expo/fetch: resume uploads send a { uri } FormData part,
# which only React Native's networking supports. Restart with `npx expo start --clear` after changing.
EXPO_PUBLIC_USE_RN_FETCH=true
